# ==============================================================================
# NEXUS — fichiers non versionnés
# ==============================================================================
# Règle : tout ce qui est reconstructible (dépendances, builds, caches) ou
# secret (.env) reste hors de Git. Les lockfiles, eux, SONT versionnés : ils
# garantissent que tout le monde installe exactement les mêmes versions.

# --- Dépendances (reconstructibles : composer install / npm ci) ---------------
vendor/
node_modules/

# --- Secrets ------------------------------------------------------------------
.env
.env.*
!.env.example

# --- PHP ----------------------------------------------------------------------
*.php~
*.php.bak
.php_cs.cache
.php-cs-fixer.cache
.phpunit.result.cache
.phpunit.cache/

# --- Frontend / build ---------------------------------------------------------
dist/
build/
.vite/
*.min.js
*.min.css
*.tsbuildinfo

# --- Journaux -----------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE ----------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# --- OS -----------------------------------------------------------------------
.DS_Store
Thumbs.db
