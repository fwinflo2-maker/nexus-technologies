# Service d'agents NEXUS — squelette de recherche.
#
# Ces agents n'exécutent AUCUNE opération financière : ils refusent
# explicitement (501 AGENT_NOT_CONFIGURED) tant qu'ils ne sont pas branchés
# sur les moteurs réels de nexus-api. Ne jamais leur faire produire un verdict
# ou un devis par défaut.

# OBLIGATOIRE : sans ce jeton, le service refuse de démarrer (fail-closed).
# Générer : openssl rand -hex 32
NEXUS_AGENTS_TOKEN=

# Interface d'écoute. Défaut 127.0.0.1 : ce service est appelé de serveur à
# serveur et n'a pas à être joignable depuis l'extérieur.
HOST=127.0.0.1
PORT=3001

# Origines CORS autorisées (séparées par des virgules). Vide = aucune origine
# navigateur autorisée, ce qui est le défaut voulu.
NEXUS_AGENTS_ORIGINS=
