{
    "name": "nexus-corp/nexus-api-app",
    "description": "NEXUS Technologies API — production backend (htdocs/api-app)",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-bcmath": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Nexus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nexus\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "db:test": "php scripts/setup_test_db.php"
    },
    "config": {
        "sort-packages": true
    }
}
