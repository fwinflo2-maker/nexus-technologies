# --- dLocal -----------------------------------------------------------------
PROVIDER_DLOCAL_ENABLED=false
PROVIDER_DLOCAL_ENV=sandbox
PROVIDER_DLOCAL_SANDBOX_API_KEY=
PROVIDER_DLOCAL_PRODUCTION_API_KEY=
