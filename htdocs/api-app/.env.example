# Copier ce fichier vers `.env` puis adapter les valeurs si nécessaire.
# Attention : `.env` contient des secrets et ne doit jamais être versionné.

# Environnement : development (défauts XAMPP) ou production (fail-closed).
APP_ENV=development
# Origines autorisées pour le CORS, séparées par des virgules.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL du frontend (liens des e-mails de confirmation / reset).
APP_FRONTEND_URL=http://localhost:5173

# ============================================================================
# MAIL — confirmation de compte + mot de passe oublié
# ============================================================================
# En development, sans SMTP, les e-mails sont écrits dans storage/mail/
# et le lien (verify_url / reset_url) est renvoyé dans la réponse API.
# En production, MAIL_HOST est requis pour que les e-mails partent vraiment.
MAIL_FROM=noreply@nexus.local
MAIL_FROM_NAME=Nexus
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexus
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# Secret de signature des JWT (à changer en production, ≥ 32 caractères).
# Générer un secret aléatoire, par exemple : openssl rand -hex 32
JWT_SECRET=nexus-dev-secret-change-me
JWT_TTL=86400
# Clé de chiffrement des données sensibles (≥ 32 caractères).
# Générer : openssl rand -hex 32
APP_KEY=nexus-dev-data-key-change-me

# ============================================================================
# SANCTIONS — filtrage réglementaire (PolicyEngine)
# ============================================================================
# Le filtrage des sanctions n'est JAMAIS simulé. En l'absence de source
# configurée, le contrôle est déclaré indisponible (UNAVAILABLE) et :
#
#   - en PRODUCTION  → la transaction est REFUSÉE (fail-closed). Déplacer de
#                      l'argent réel sans filtrage n'est pas autorisé ;
#   - en SANDBOX     → la transaction passe en REVIEW_REQUIRED et le verdict
#                      indique explicitement que le contrôle n'a pas eu lieu.
#
# Un contrôle absent n'est jamais présenté comme « passé ».
#
# Deux sources possibles (la première renseignée l'emporte) :
#   NEXUS_SANCTIONS_COUNTRIES  codes ISO-2 séparés par des virgules
#   NEXUS_SANCTIONS_LIST_FILE  chemin d'un fichier, une entrée par ligne
#                              (« # » introduit un commentaire)
#
# Un fichier déclaré mais illisible reste UNAVAILABLE : une liste qu'on ne
# peut pas lire ne signifie pas « aucune sanction ».
#
# NOTE : le format « codes pays » est volontairement minimal et ne remplace
# pas un screening nominatif (OFAC / UE / ONU). Pour brancher un vrai
# provider de screening, remplacer la source dans
# src/Services/SanctionsScreening.php : les trois états et le comportement
# fail-closed restent inchangés.
NEXUS_SANCTIONS_COUNTRIES=
NEXUS_SANCTIONS_LIST_FILE=

# Seeding de démonstration : autorisé hors production uniquement.
# Mettre à 0 pour désactiver même en développement.
# En production, le seeding est TOUJOURS refusé, quelle que soit cette valeur.
NEXUS_DEMO_SEED=1

# ============================================================================
# SUMSUB — KYC / KYB (provider officiel de vérification d'identité)
# ============================================================================
# AUCUNE VALEUR RÉELLE ICI. Les secrets vivent dans l'environnement, jamais
# dans Git ni en SQL. Générer l'App Token et la Secret Key dans le dashboard
# Sumsub (Dev Space → App Tokens). Sandbox et production ont des jeux DISTINCTS.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_BASE_URL=https://api.sumsub.com
# sandbox | production
SUMSUB_ENVIRONMENT=sandbox
# Niveaux de vérification définis dans Workflow Orchestration (Sumsub).
# KYC = personne physique ; KYB = entreprise (societé + représentants + UBO).
SUMSUB_LEVEL_NAME=
SUMSUB_LEVEL_NAME_KYB=
# Durée de vie des access tokens SDK, en secondes (défaut Sumsub : 600).
SUMSUB_TOKEN_TTL=600

# OpenCorporates — registre entreprises (KYB fallback).
# https://api.opencorporates.com/documentation/API-Reference
OPENCORPORATES_API_TOKEN=

# ============================================================================
# PROVIDERS — configuration (AUCUNE VRAIE CLÉ ICI : placeholders vides).
# ============================================================================
# Les credentials sont lus depuis l'ENVIRONNEMENT uniquement. Le Core reste
# provider-agnostic : chaque provider est isolé derrière son adaptateur.
#
# Convention (slug + champs définis dans ProviderCatalog) :
#   PROVIDER_{SLUG}_ENABLED             = true|false
#   PROVIDER_{SLUG}_ENV                 = sandbox|production
#   PROVIDER_{SLUG}_{CHAMP}             = valeur générique
#   PROVIDER_{SLUG}_{SANDBOX}_{CHAMP}   = valeur réservée sandbox (prioritaire)
#   PROVIDER_{SLUG}_{PRODUCTION}_{CHAMP}= valeur réservée production (prioritaire)
#
# Tant qu'AUCUN provider n'est configuré, Nexus reste en « mode démo » : tous
# les providers du catalogue sont éligibles au routing. Dès qu'au moins UN
# provider est activé/renseigné, le mode STRICT s'active et seuls les providers
# configurés participent au routing.
#
# Health check : `PROVIDERS_CONNECTIVITY_CHECK=true` active la sonde TCP réelle
# (sinon le statut reste « configured — connectivité non testée »).

# ─── ISOLATION SANDBOX / PRODUCTION (règle stricte) ──────────────────────────
# Chaque credential DOIT être scopée par environnement :
#
#     PROVIDER_{SLUG}_SANDBOX_{FIELD}       (environnement de test)
#     PROVIDER_{SLUG}_PRODUCTION_{FIELD}    (environnement réel)
#
# La forme générique PROVIDER_{SLUG}_{FIELD} n'est PLUS lue : elle permettait
# à une clé de production d'être servie en sandbox (et inversement). Si une
# telle variable subsiste, le provider est signalé INVALID_CONFIGURATION au
# lieu d'être utilisé silencieusement.
#
# Une credential absente dans l'environnement demandé reste absente : aucun
# repli vers l'autre environnement n'a lieu.
# ─────────────────────────────────────────────────────────────────────────────

# --- Drapeaux globaux (optionnels) ------------------------------------------
PROVIDERS_ENV=sandbox
PROVIDERS_STRICT_MODE=
PROVIDERS_CONNECTIVITY_CHECK=

# --- Stripe -----------------------------------------------------------------
PROVIDER_STRIPE_ENABLED=false
PROVIDER_STRIPE_ENV=sandbox
PROVIDER_STRIPE_SANDBOX_API_KEY=
PROVIDER_STRIPE_PRODUCTION_API_KEY=
PROVIDER_STRIPE_SANDBOX_SECRET_KEY=
PROVIDER_STRIPE_PRODUCTION_SECRET_KEY=
PROVIDER_STRIPE_SANDBOX_PUBLIC_KEY=
PROVIDER_STRIPE_PRODUCTION_PUBLIC_KEY=
PROVIDER_STRIPE_SANDBOX_WEBHOOK_SECRET=
PROVIDER_STRIPE_PRODUCTION_WEBHOOK_SECRET=
PROVIDER_STRIPE_SANDBOX_ACCOUNT_ID=
PROVIDER_STRIPE_PRODUCTION_ACCOUNT_ID=

# --- Stripe Issuing (cartes virtuelles) -------------------------------------
# Même compte Stripe possible : repli runtime sur PROVIDER_STRIPE_*_SECRET_KEY
# si stripe_issuing n'a pas sa propre clé. Issuing doit être activé au Dashboard.
PROVIDER_STRIPE_ISSUING_ENABLED=false
PROVIDER_STRIPE_ISSUING_ENV=sandbox
PROVIDER_STRIPE_ISSUING_SANDBOX_SECRET_KEY=
PROVIDER_STRIPE_ISSUING_PRODUCTION_SECRET_KEY=
PROVIDER_STRIPE_ISSUING_SANDBOX_WEBHOOK_SECRET=
PROVIDER_STRIPE_ISSUING_PRODUCTION_WEBHOOK_SECRET=

# --- Maplerad Issuing (cartes virtuelles Afrique) ---------------------------
# Secret Key Bearer : dashboard Maplerad → Settings → API Keys.
# Sandbox et production sont des clés distinctes — jamais mélangées.
PROVIDER_MAPLERAD_ENABLED=false
PROVIDER_MAPLERAD_ENV=sandbox
PROVIDER_MAPLERAD_SANDBOX_SECRET_KEY=
PROVIDER_MAPLERAD_PRODUCTION_SECRET_KEY=
PROVIDER_MAPLERAD_SANDBOX_WEBHOOK_SECRET=
PROVIDER_MAPLERAD_PRODUCTION_WEBHOOK_SECRET=


# --- Onafriq (slug catalogue: onfriq) ----------------------------------------
# Alias organisationnel « onafriq » → slug `onfriq` dans les scripts.
PROVIDER_ONFRIQ_ENABLED=false
PROVIDER_ONFRIQ_ENV=sandbox
PROVIDER_ONFRIQ_SANDBOX_API_KEY=
PROVIDER_ONFRIQ_PRODUCTION_API_KEY=
PROVIDER_ONFRIQ_SANDBOX_API_SECRET=
PROVIDER_ONFRIQ_PRODUCTION_API_SECRET=

# --- Thunes -----------------------------------------------------------------
PROVIDER_THUNES_ENABLED=false
PROVIDER_THUNES_ENV=sandbox
PROVIDER_THUNES_SANDBOX_API_KEY=
PROVIDER_THUNES_PRODUCTION_API_KEY=
PROVIDER_THUNES_SANDBOX_API_SECRET=
PROVIDER_THUNES_PRODUCTION_API_SECRET=
PROVIDER_THUNES_SANDBOX_WEBHOOK_SECRET=
PROVIDER_THUNES_PRODUCTION_WEBHOOK_SECRET=

# --- Wise Platform ----------------------------------------------------------
PROVIDER_WISE_ENABLED=false
PROVIDER_WISE_ENV=sandbox
PROVIDER_WISE_SANDBOX_CLIENT_ID=
PROVIDER_WISE_PRODUCTION_CLIENT_ID=
PROVIDER_WISE_SANDBOX_CLIENT_SECRET=
PROVIDER_WISE_PRODUCTION_CLIENT_SECRET=
PROVIDER_WISE_SANDBOX_PROFILE_ID=
PROVIDER_WISE_PRODUCTION_PROFILE_ID=

# --- Western Union (Mass Payments, mTLS) ------------------------------------
# Certificats : chemins serveur (CURLOPT_SSLCERT / CURLOPT_SSLKEY), pas de PEM inline.
PROVIDER_WESTERN_UNION_ENABLED=false
PROVIDER_WESTERN_UNION_ENV=sandbox
PROVIDER_WESTERN_UNION_SANDBOX_CLIENT_ID=
PROVIDER_WESTERN_UNION_PRODUCTION_CLIENT_ID=
PROVIDER_WESTERN_UNION_SANDBOX_CLIENT_CERT_PATH=
PROVIDER_WESTERN_UNION_PRODUCTION_CLIENT_CERT_PATH=
PROVIDER_WESTERN_UNION_SANDBOX_CLIENT_KEY_PATH=
PROVIDER_WESTERN_UNION_PRODUCTION_CLIENT_KEY_PATH=
PROVIDER_WESTERN_UNION_SANDBOX_PARTNER_ID=
PROVIDER_WESTERN_UNION_PRODUCTION_PARTNER_ID=

# --- MoneyGram (OAuth2 client credentials) ----------------------------------
PROVIDER_MONEYGRAM_ENABLED=false
PROVIDER_MONEYGRAM_ENV=sandbox
PROVIDER_MONEYGRAM_SANDBOX_CLIENT_ID=
PROVIDER_MONEYGRAM_PRODUCTION_CLIENT_ID=
PROVIDER_MONEYGRAM_SANDBOX_CLIENT_SECRET=
PROVIDER_MONEYGRAM_PRODUCTION_CLIENT_SECRET=
PROVIDER_MONEYGRAM_SANDBOX_AGENT_PARTNER_ID=
PROVIDER_MONEYGRAM_PRODUCTION_AGENT_PARTNER_ID=

# --- Nium -------------------------------------------------------------------
PROVIDER_NIUM_ENABLED=false
PROVIDER_NIUM_ENV=sandbox
PROVIDER_NIUM_SANDBOX_CLIENT_ID=
PROVIDER_NIUM_PRODUCTION_CLIENT_ID=
PROVIDER_NIUM_SANDBOX_CLIENT_SECRET=
PROVIDER_NIUM_PRODUCTION_CLIENT_SECRET=

# --- Currencycloud ----------------------------------------------------------
PROVIDER_CURRENCYCLOUD_ENABLED=false
PROVIDER_CURRENCYCLOUD_ENV=sandbox
PROVIDER_CURRENCYCLOUD_SANDBOX_API_KEY=
PROVIDER_CURRENCYCLOUD_PRODUCTION_API_KEY=
