# Fichier d'environnement local (secrets) — jamais versionné.
.env

# Uploads runtime (avatars, support) — conserver les .gitkeep
/public/uploads/**
!/public/uploads/**/.gitkeep

# Journaux
*.log

# Cache de tests PHPUnit
.phpunit.cache/

# Clés de harness sandbox (PEM) — jamais versionnées.
scripts/provider_sandbox/.keys/
