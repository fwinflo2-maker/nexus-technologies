# Copier ce fichier vers `.env` puis adapter les valeurs si nécessaire.
# Attention : `.env` contient des secrets et ne doit jamais être versionné.

# Environnement : development (défauts XAMPP) ou production (fail-closed).
APP_ENV=development
# Origines autorisées pour le CORS, séparées par des virgules.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexus
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
# Secret de signature des JWT (à changer en production, ≥ 32 caractères).
# Générer un secret aléatoire, par exemple : openssl rand -hex 32
JWT_SECRET=nexus-dev-secret-change-me
JWT_TTL=86400
# Clé de chiffrement des données sensibles (≥ 32 caractères).
# Générer : openssl rand -hex 32
APP_KEY=nexus-dev-data-key-change-me
# Client ID Google OAuth (identifiant public fourni par Google Cloud Console).
# OBLIGATOIRE : sans cette valeur, la connexion Google est refusée (aucun
# repli sur une valeur en dur). Renseignez le client ID de VOTRE projet.
GOOGLE_CLIENT_ID=

# Seeding de démonstration : autorisé hors production uniquement.
# Mettre à 0 pour désactiver même en développement.
# En production, le seeding est TOUJOURS refusé, quelle que soit cette valeur.
NEXUS_DEMO_SEED=1

# ============================================================================
# SUMSUB — KYC / KYB (provider officiel de vérification d'identité)
# ============================================================================
# AUCUNE VALEUR RÉELLE ICI. Les secrets vivent dans l'environnement, jamais
# dans Git ni en SQL. Générer l'App Token et la Secret Key dans le dashboard
# Sumsub (Dev Space → App Tokens). Sandbox et production ont des jeux DISTINCTS.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_BASE_URL=https://api.sumsub.com
# sandbox | production
SUMSUB_ENVIRONMENT=sandbox
# Niveaux de vérification définis dans Workflow Orchestration (Sumsub).
# KYC = personne physique ; KYB = entreprise (societé + représentants + UBO).
SUMSUB_LEVEL_NAME=
SUMSUB_LEVEL_NAME_KYB=
# Durée de vie des access tokens SDK, en secondes (défaut Sumsub : 600).
SUMSUB_TOKEN_TTL=600

# ============================================================================
# PROVIDERS — configuration (AUCUNE VRAIE CLÉ ICI : placeholders vides).
# ============================================================================
# Les credentials sont lus depuis l'ENVIRONNEMENT uniquement. Le Core reste
# provider-agnostic : chaque provider est isolé derrière son adaptateur.
#
# Convention (slug + champs définis dans ProviderCatalog) :
#   PROVIDER_{SLUG}_ENABLED             = true|false
#   PROVIDER_{SLUG}_ENV                 = sandbox|production
#   PROVIDER_{SLUG}_{CHAMP}             = valeur générique
#   PROVIDER_{SLUG}_{SANDBOX}_{CHAMP}   = valeur réservée sandbox (prioritaire)
#   PROVIDER_{SLUG}_{PRODUCTION}_{CHAMP}= valeur réservée production (prioritaire)
#
# Tant qu'AUCUN provider n'est configuré, Nexus reste en « mode démo » : tous
# les providers du catalogue sont éligibles au routing. Dès qu'au moins UN
# provider est activé/renseigné, le mode STRICT s'active et seuls les providers
# configurés participent au routing.
#
# Health check : `PROVIDERS_CONNECTIVITY_CHECK=true` active la sonde TCP réelle
# (sinon le statut reste « configured — connectivité non testée »).

# ─── ISOLATION SANDBOX / PRODUCTION (règle stricte) ──────────────────────────
# Chaque credential DOIT être scopée par environnement :
#
#     PROVIDER_{SLUG}_SANDBOX_{FIELD}       (environnement de test)
#     PROVIDER_{SLUG}_PRODUCTION_{FIELD}    (environnement réel)
#
# La forme générique PROVIDER_{SLUG}_{FIELD} n'est PLUS lue : elle permettait
# à une clé de production d'être servie en sandbox (et inversement). Si une
# telle variable subsiste, le provider est signalé INVALID_CONFIGURATION au
# lieu d'être utilisé silencieusement.
#
# Une credential absente dans l'environnement demandé reste absente : aucun
# repli vers l'autre environnement n'a lieu.
# ─────────────────────────────────────────────────────────────────────────────

# --- Drapeaux globaux (optionnels) ------------------------------------------
PROVIDERS_ENV=sandbox
PROVIDERS_STRICT_MODE=
PROVIDERS_CONNECTIVITY_CHECK=

# --- Stripe -----------------------------------------------------------------
PROVIDER_STRIPE_ENABLED=false
PROVIDER_STRIPE_ENV=sandbox
PROVIDER_STRIPE_SANDBOX_API_KEY=
PROVIDER_STRIPE_PRODUCTION_API_KEY=
PROVIDER_STRIPE_SANDBOX_SECRET_KEY=
PROVIDER_STRIPE_PRODUCTION_SECRET_KEY=
PROVIDER_STRIPE_SANDBOX_PUBLIC_KEY=
PROVIDER_STRIPE_PRODUCTION_PUBLIC_KEY=
PROVIDER_STRIPE_SANDBOX_WEBHOOK_SECRET=
PROVIDER_STRIPE_PRODUCTION_WEBHOOK_SECRET=
PROVIDER_STRIPE_SANDBOX_ACCOUNT_ID=
PROVIDER_STRIPE_PRODUCTION_ACCOUNT_ID=

