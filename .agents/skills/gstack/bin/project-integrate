#!/usr/bin/env bash
# Integrate gstack into a project so teammates get the full AI workflow on git clone.
#
# Usage:
#   bin/project-integrate [--host claude|agents|cursor|all|auto] [--dir /path/to/project]
#
# Examples:
#   bin/project-integrate                     # auto-detect, integrate into cwd
#   bin/project-integrate --host agents       # Cursor Cloud / Codex / Gemini path
#   bin/project-integrate --host claude       # Claude Code vendored install
#   bin/project-integrate --host all          # both .claude/ and .agents/ paths
#   bin/project-integrate --dir ../my-app     # integrate into another repo
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GSTACK_SOURCE="$(cd "$SCRIPT_DIR/.." && pwd)"
TARGET_DIR="$(pwd)"
HOST="auto"

usage() {
  cat <<'EOF'
Usage: bin/project-integrate [--host MODE] [--dir PATH]

Integrate gstack into a project repo so teammates get skills on git clone.

Modes:
  auto    Default. Installs .agents/skills/gstack (Cursor Cloud, Codex, Gemini)
          and .claude/skills/gstack when Claude Code is installed.
  agents  .agents/skills/gstack + AGENTS.md section (Cursor Cloud Agents)
  claude  .claude/skills/gstack + CLAUDE.md section (Claude Code)
  cursor  .cursor/skills/gstack + AGENTS.md section (Cursor IDE)
  all     agents + claude paths together

After integration, commit the vendored gstack directory and updated AGENTS.md/CLAUDE.md.
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --host) [ -z "${2:-}" ] && { echo "Missing value for --host" >&2; usage; exit 1; }; HOST="$2"; shift 2 ;;
    --host=*) HOST="${1#--host=}"; shift ;;
    --dir) [ -z "${2:-}" ] && { echo "Missing value for --dir" >&2; usage; exit 1; }; TARGET_DIR="$2"; shift 2 ;;
    --dir=*) TARGET_DIR="${1#--dir=}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 1 ;;
  esac
done

TARGET_DIR="$(cd "$TARGET_DIR" && pwd)"

resolve_source() {
  if [ -x "$GSTACK_SOURCE/setup" ]; then
    echo "$GSTACK_SOURCE"
    return 0
  fi
  if [ -d "$HOME/.claude/skills/gstack" ] && [ -x "$HOME/.claude/skills/gstack/setup" ]; then
    echo "$HOME/.claude/skills/gstack"
    return 0
  fi
  echo "Error: gstack source not found. Install globally first or run from the gstack repo." >&2
  exit 1
}

copy_gstack() {
  local dest="$1"
  local source="$2"
  if [ -e "$dest" ]; then
    echo "  removing existing $dest"
    rm -rf "$dest"
  fi
  mkdir -p "$(dirname "$dest")"
  echo "  copying gstack → $dest"
  cp -R "$source" "$dest"
  rm -rf "$dest/.git"
}

append_section_if_missing() {
  local file="$1"
  local marker="$2"
  local section="$3"
  if [ -f "$file" ] && grep -q "$marker" "$file" 2>/dev/null; then
    echo "  $file already has gstack section — skipped"
    return 0
  fi
  {
    echo ""
    echo "$section"
  } >> "$file"
  echo "  updated $file"
}

agents_section() {
  cat <<'EOF'
## gstack

AI engineering workflow skills live in `.agents/skills/`. Invoke by name (e.g. `/office-hours`, `/review`, `/ship`).

- Use `/browse` from gstack for all web browsing. Never use browser MCP tools.
- If skills break after an upgrade: `cd .agents/skills/gstack && ./setup --host codex`
- Start with `/office-hours` for new features, `/review` before landing, `/ship` to open a PR.

Available skills: /office-hours, /plan-ceo-review, /plan-eng-review, /plan-design-review, /design-consultation, /design-shotgun, /design-html, /review, /ship, /land-and-deploy, /canary, /benchmark, /browse, /open-gstack-browser, /qa, /qa-only, /design-review, /setup-browser-cookies, /setup-deploy, /retro, /investigate, /document-release, /codex, /cso, /autoplan, /careful, /freeze, /guard, /unfreeze, /gstack-upgrade, /learn.
EOF
}

claude_section() {
  cat <<'EOF'
## gstack

Use `/browse` from gstack for all web browsing. Never use mcp__claude-in-chrome__* tools.

If gstack skills aren't working, run `cd .claude/skills/gstack && ./setup` to rebuild the binary and register skills.

Available skills: /office-hours, /plan-ceo-review, /plan-eng-review, /plan-design-review, /design-consultation, /design-shotgun, /design-html, /review, /ship, /land-and-deploy, /canary, /benchmark, /browse, /open-gstack-browser, /qa, /qa-only, /design-review, /setup-browser-cookies, /setup-deploy, /retro, /investigate, /document-release, /codex, /cso, /autoplan, /careful, /freeze, /guard, /unfreeze, /gstack-upgrade, /learn.
EOF
}

integrate_agents() {
  local source="$1"
  local dest="$TARGET_DIR/.agents/skills/gstack"
  echo "Integrating gstack for Cursor Cloud / Codex / Gemini (.agents/skills/)..."
  copy_gstack "$dest" "$source"
  ( cd "$dest" && ./setup --host codex --no-prefix )
  touch "$TARGET_DIR/AGENTS.md"
  append_section_if_missing "$TARGET_DIR/AGENTS.md" "## gstack" "$(agents_section)"
}

integrate_claude() {
  local source="$1"
  local dest="$TARGET_DIR/.claude/skills/gstack"
  echo "Integrating gstack for Claude Code (.claude/skills/)..."
  copy_gstack "$dest" "$source"
  ( cd "$dest" && ./setup --local --no-prefix )
  touch "$TARGET_DIR/CLAUDE.md"
  append_section_if_missing "$TARGET_DIR/CLAUDE.md" "## gstack" "$(claude_section)"
}

integrate_cursor() {
  local source="$1"
  local dest="$TARGET_DIR/.cursor/skills/gstack"
  echo "Integrating gstack for Cursor IDE (.cursor/skills/)..."
  copy_gstack "$dest" "$source"
  ( cd "$dest" && ./setup --host cursor --no-prefix )
  touch "$TARGET_DIR/AGENTS.md"
  append_section_if_missing "$TARGET_DIR/AGENTS.md" "## gstack" "$(agents_section)"
}

SOURCE="$(resolve_source)"
echo "gstack source: $SOURCE"
echo "target project: $TARGET_DIR"
echo ""

case "$HOST" in
  agents) integrate_agents "$SOURCE" ;;
  claude) integrate_claude "$SOURCE" ;;
  cursor) integrate_cursor "$SOURCE" ;;
  all)
    integrate_agents "$SOURCE"
    echo ""
    integrate_claude "$SOURCE"
    ;;
  auto)
    integrate_agents "$SOURCE"
    if command -v claude >/dev/null 2>&1; then
      echo ""
      integrate_claude "$SOURCE"
    fi
    ;;
  *)
    echo "Unknown --host value: $HOST (expected auto, agents, claude, cursor, or all)" >&2
    exit 1
    ;;
esac

echo ""
echo "Done. Commit the vendored gstack directory and AGENTS.md/CLAUDE.md so teammates get it on git clone."
